{% comment %}
  One life-gallery photo: webp sources from the imagemagick widths, with the
  jpg as fallback and as the zoom target.
  Params: photo (a page.photos / page.featured entry), sizes.
{% endcomment %}
{% assign stem = include.photo.file | split: '.' | first %}
{% capture base %}{{ '/assets/img/life/' | append: stem | relative_url }}{% endcapture %}
<picture>
  <source
    type="image/webp"
    srcset="{% for w in site.imagemagick.widths %}{{ base }}-{{ w }}.webp {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
    sizes="{{ include.sizes }}"
  >
  <img
    src="{{ '/assets/img/life/' | append: include.photo.file | relative_url }}"
    width="{{ include.photo.w }}"
    height="{{ include.photo.h }}"
    alt="{{ include.photo.alt }}"
    loading="lazy"
    decoding="async"
    data-zoomable
  >
</picture>
